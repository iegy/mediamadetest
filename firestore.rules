rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roles) {
      return isSignedIn() && myRole() in roles;
    }

    // كل مستخدم مسجل يقدر يقرأ ملفات المستخدمين (عشان الأدوار تتعرض في الواجهة)،
    // بس الإدارة بس اللي تقدر تعدّل الأدوار
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if hasRole(['management']);
    }

    // العملاء: الإدارة، إدارة العملاء، والمبيعات
    match /clients/{clientId} {
      allow read, write: if hasRole(['management', 'client_management', 'sales']);
    }

    // المشاريع: الإدارة وإدارة العملاء بالكامل، الإنتاج والمونتاج قراءة بس
    // (هيتظبط أكتر بحيث كل فريق يشوف بس المشاريع المُسندة له، لما نبني موديول المشاريع)
    match /projects/{projectId} {
      allow read: if hasRole(['management', 'client_management', 'production', 'editor']);
      allow write: if hasRole(['management', 'client_management']);
    }

    // باقي الكوليكشنز (quotations, payments, expenses, activity...) هيتضاف لها قواعد
    // مخصوصة مع بناء كل موديول في مراحله
  }
}
